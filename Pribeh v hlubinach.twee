:: StoryInit {"position":"500,350","size":"100,100"}
<<cacheaudio "epic" "audio/EpicDnD.mp3">>
<<cacheaudio "victory" "audio/Victory.mp3">>

<<set $hp = 3>>
<<set $maxHp = 3>>
<<set $dead = false>>

<<widget "HUD">> ŽIVOTY: <<print "❤️".repeat($hp) + "🤍".repeat($maxHp - $hp)>>
<</widget>>


<<widget "MinusZivot">>
	<<set _n = (_args.length ? Number(_args[0]) : 1)>>
	<<if isNaN(_n) or _n <= 0>><<set _n = 1>><</if>>

	<<set $hp = Math.max(0, $hp - _n)>>

	<<timed 0ms>>
		<<replace "#hud">><<HUD>><</replace>>
	<</timed>>

	<<if $hp <= 0>>
		<<set $dead = true>>
	<</if>>
<</widget>>


